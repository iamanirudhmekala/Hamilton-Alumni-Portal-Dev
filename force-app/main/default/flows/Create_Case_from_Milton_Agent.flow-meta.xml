        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>Milton_Knowledge_Category</actionName>
        <actionType>generatePromptResponse</actionType>
        <connector>
            <targetReference>Get_Milton_Knowledge_Category_Metadata</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>Input:Chat_Transcript</name>
