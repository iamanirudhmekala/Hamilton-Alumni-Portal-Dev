    <formulas>
        <description>FY end date based on today&apos;s date. Next coming 6/30</description>
        <name>FY_End_Date</name>
        <dataType>Date</dataType>
        <expression>IF(MONTH(TODAY()) &gt;= 7, DATE(YEAR(TODAY()) + 1, 6, 30), DATE(YEAR(TODAY()), 6, 30))</expression>
    </formulas>
