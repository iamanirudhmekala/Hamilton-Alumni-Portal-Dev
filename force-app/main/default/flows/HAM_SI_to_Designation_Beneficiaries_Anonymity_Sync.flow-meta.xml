    <description>When an SP (No Student Consent) Service Indicator&apos;s dates/active status change, re-syncs HAM_Anonymous__c on all of the contact&apos;s Designation Beneficiaries. Active = Start populated AND (End blank OR End on/after today). Faults email nvaidya + awadke.</description>
    <environments>Default</environments>
    <formulas>
        <name>Formula_SI_IsActive</name>
        <dataType>Boolean</dataType>
        <expression>AND(
  NOT(ISBLANK({!$Record.ucinn_ascendv2__Start_Date__c})),
  OR(
    ISBLANK({!$Record.ucinn_ascendv2__End_Date__c}),
    {!$Record.ucinn_ascendv2__End_Date__c} &gt;= TODAY()
  )
)</expression>
    </formulas>
    <interviewLabel>HAM SI to Designation Beneficiaries Anonymity Sync {!$Flow.CurrentDateTime}</interviewLabel>
    <label>HAM SI to Designation Beneficiaries Anonymity Sync</label>
