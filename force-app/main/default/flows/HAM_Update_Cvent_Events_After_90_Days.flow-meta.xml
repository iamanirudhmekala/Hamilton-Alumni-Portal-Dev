<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Is_the_Event_Pass_90_Days</name>
        <label>Is the Event Pass 90 Days</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Outcome_1_of_Is_the_Event_Pass_90_Days</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CventEvents__pkg_EndDate__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>Days90PastToday</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_the_Event_Status_and_Set_Private_Flag</targetReference>
            </connector>
            <label>Outcome 1 of Is the Event Pass 90 Days</label>
        </rules>
    </decisions>
    <description>This Flow updates the event to completed after 90 days from the end date and mark the event as private to hide it from Portal.</description>
    <environments>Default</environments>
    <formulas>
        <description>Calculate the 90 Day prior to today to get the date.</description>
        <name>Days90PastToday</name>
        <dataType>Date</dataType>
        <expression>TODAY() - 90</expression>
    </formulas>
    <interviewLabel>HAM Update Cvent Events After 90 Days {!$Flow.CurrentDateTime}</interviewLabel>
    <label>HAM Update Cvent Events After 90 Days</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>This block updates the event to completed after 90 days from the end date and mark the event as private to hide it from Portal.</description>
        <name>Update_the_Event_Status_and_Set_Private_Flag</name>
        <label>Update the Event Status and Set Private Flag</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>ADVPublicPrivate__c</field>
            <value>
                <stringValue>Private</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CventEvents__pkg_EventStatus__c</field>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Is_the_Event_Pass_90_Days</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CventEvents__pkg_EventStatus__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </filters>
        <filters>
            <field>ADVPublicPrivate__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Private</stringValue>
            </value>
        </filters>
        <object>CventEvents__Event__c</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2026-05-05</startDate>
            <startTime>14:15:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
</Flow>
