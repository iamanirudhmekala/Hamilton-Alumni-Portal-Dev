<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Checks if Tribute Type 1 is &quot;In Honor Of&quot;, the In Memory Honor Constituent 1 lookup is populated, and that constituent is deceased — using cross-object field reference to avoid SOQL queries in bulk context.</description>
        <name>Is_Tribute_1_In_Honor_Of</name>
        <label>Is Tribute Type 1 = In Honor Of and Constituent 1 Deceased?</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <defaultConnector>
            <targetReference>Is_Tribute_2_In_Honor_Of</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Tribute_1_Is_In_Honor_Of</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ucinn_ascendv2__Tribute_Type_1__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>In Honor Of</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ucinn_ascendv2__In_Memory_Honor_Contact_1__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ucinn_ascendv2__In_Memory_Honor_Contact_1__r.ucinn_ascendv2__Is_Deceased__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Tribute_Type_1_In_Memory_Of</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checks if Tribute Type 2 is &quot;In Honor Of&quot;, the In Memory Honor Constituent 2 lookup is populated, and that constituent is deceased — using cross-object field reference to avoid SOQL queries in bulk context.</description>
        <name>Is_Tribute_2_In_Honor_Of</name>
        <label>Is Tribute Type 2 = In Honor Of and Constituent 2 Deceased?</label>
        <locationX>176</locationX>
        <locationY>611</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Tribute_2_Is_In_Honor_Of</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ucinn_ascendv2__Tribute_Type_2__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>In Honor Of</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ucinn_ascendv2__In_Memory_Honor_Contact_2__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ucinn_ascendv2__In_Memory_Honor_Contact_2__r.ucinn_ascendv2__Is_Deceased__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Tribute_Type_2_In_Memory_Of</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>When an RTV2 record is created or updated and the In Memory Honor Constituent 1 or 2 lookup is populated, this flow checks if the Tribute Type is set to &quot;In Honor Of&quot; and the linked constituent is deceased. If so, it automatically updates the Tribute Type to &quot;In Memory Of&quot; so the record processes successfully without being routed to Manual Review.</description>
    <environments>Default</environments>
    <interviewLabel>HAM RTV2 Update Tribute Type 1 and 2 {!$Flow.CurrentDateTime}</interviewLabel>
    <label>HAM RTV2 Update Tribute Type 1 and 2</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Updates Tribute Type 1 to &quot;In Memory Of&quot; on the triggering RTV2 record before it is saved.</description>
        <name>Set_Tribute_Type_1_In_Memory_Of</name>
        <label>Set Tribute Type 1 = In Memory Of</label>
        <locationX>176</locationX>
        <locationY>449</locationY>
        <connector>
            <targetReference>Is_Tribute_2_In_Honor_Of</targetReference>
        </connector>
        <inputAssignments>
            <field>ucinn_ascendv2__Tribute_Type_1__c</field>
            <value>
                <stringValue>In Memory Of</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>Updates Tribute Type 2 to &quot;In Memory Of&quot; on the triggering RTV2 record before it is saved.</description>
        <name>Set_Tribute_Type_2_In_Memory_Of</name>
        <label>Set Tribute Type 2 = In Memory Of</label>
        <locationX>176</locationX>
        <locationY>773</locationY>
        <inputAssignments>
            <field>ucinn_ascendv2__Tribute_Type_2__c</field>
            <value>
                <stringValue>In Memory Of</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Is_Tribute_1_In_Honor_Of</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>ucinn_ascendv2__In_Memory_Honor_Contact_1__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>ucinn_ascendv2__In_Memory_Honor_Contact_2__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>ucinn_ascendv2__Review_Transaction_v2__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
