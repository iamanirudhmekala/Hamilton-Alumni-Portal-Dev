            }, {
              "attributes" : {
                "imageInfos" : "",
                "richTextValue" : "<div class=\"hq-faq-wrap\">\n\n  <h1 class=\"page-title\">FAQs</h1>\n\n  <div class=\"ck-container\">\n\n    <div class=\"top-image\">\n      <img alt=\"\" src=\"https://d1ctk4ronrg3qz.cloudfront.net/cluster-landing-page%2FND5pbpcUQgKD3fb9DcUk_PG-faq-Landing-Page-Top-Image.jpg\">\n    </div>\n\n    <div class=\"row\">\n\n      <!-- LEFT COLUMN -->\n      <section class=\"col-md-6\">\n\n        <div class=\"page-tags\">\n          <h3>Is this different from the Alumni Directory, My Hamilton, and My Hamilton Connect?</h3>\n          <p>Hamilton Quad is a full featured directory and engagement platform, designed to help network and engage with your community.</p>\n        </div>\n\n        <div class=\"page-tags\">\n          <h3>Do I need to sign up if I already have a Hamilton Account?</h3>\n          <p>You already have an active account. All you need to do is login with your Hamilton single-sign-on credentials and you'll be able to take advantage of everything the HQ has to offer.</p>\n        </div>\n\n        <div class=\"page-tags\">\n          <h3>What steps do I need to take to activate/register an account if I don't have Hamilton credentials?</h3>\n          <p>To request an account, please contact <a href=\"mailto:infoserv@hamilton.edu\">infoserv@hamilton.edu</a> and include your name, email and relationship to the College.</p>\n        </div>\n\n      </section>\n\n      <!-- RIGHT COLUMN -->\n      <section class=\"col-md-6\">\n\n        <a href=\"#\" class=\"hub-cta-button\">JOIN TODAY</a>\n\n        <div class=\"page-tags\">\n          <h3>I can't log in using My Hamilton credentials. Help.</h3>\n          <p class=\"subhead upper\">Alumni</p>\n          <p>Please visit the <a href=\"#\">Forgotten Password</a> page if you have forgotten your username or password.</p>\n        </div>\n\n        <div class=\"page-tags\">\n          <p class=\"subhead\">GUESTS, PARENTS, AND TRUSTEES</p>\n          <p><strong>(who did not graduate from Hamilton)</strong><br>\n          Please visit the Guest Account <a href=\"#\">Forgotten Password</a> page to request a temporary password that allows you to reset your password.</p>\n        </div>\n\n        <div class=\"page-tags\">\n          <p class=\"subhead upper\">Students</p>\n          <p>Students already enrolled in <a href=\"#\">Hamilton Password Manager</a> should visit <a href=\"#\">password.hamilton.edu</a>. Otherwise, email the HelpDesk or call 315-859-4181.</p>\n        </div>\n\n      </section>\n\n    </div>\n  </div>\n</div>"
              },
              "definition" : "community_builder:htmlEditor",
              "id" : "691576fa-34a7-4537-9d8b-ac85250193f9",
              "type" : "component"
            } ],
