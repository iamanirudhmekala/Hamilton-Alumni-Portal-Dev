            <value>
                <fullName>Error</fullName>
                <default>false</default>
                <label>Error</label>
            </value>
            <value>
                <fullName>Warning</fullName>
                <default>false</default>
                <label>Warning</label>
            </value>
            <value>
                <fullName>Pass</fullName>
                <default>false</default>
                <label>Pass</label>
            </value>
            <value>
                <fullName>QC Summary</fullName>
                <default>false</default>
                <label>QC Summary</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
